#!/usr/bin/env bash
# Kanki Tunnel - terminal manager
set -euo pipefail
ETC=/etc/kanki; APP=/opt/kanki
Y=$'\033[1;33m'; G=$'\033[1;32m'; R=$'\033[1;31m'; D=$'\033[2m'; N=$'\033[0m'
[[ $EUID -eq 0 ]] || { echo "Run as root."; exit 1; }
[[ -f $ETC/panel.json ]] || { echo "Kanki is not installed."; exit 1; }
cfg(){ python3 -c "import json;print(json.load(open('$ETC/panel.json')).get('$1',''))"; }

info(){
  local ip host
  ip="$(curl -4 -fsS --max-time 5 https://api.ipify.org 2>/dev/null || hostname -I | awk '{print $1}')"
  host="$ip"; [[ -n "$(cfg domain)" ]] && host="$(cfg domain)"
  echo -e "  Panel:   ${Y}https://${host}:$(cfg port)/$(cfg base_path)/${N}"
  echo -e "  Service: $(systemctl is-active kanki-panel || true)"
  echo -e "  Engine:  $([[ -x /usr/local/bin/backpack ]] && echo installed || echo "${R}missing${N}")"
  echo -e "  Tunnels:"
  local n=0 u name
  for u in /etc/systemd/system/backpack-*.service; do
    [[ -e $u ]] || continue
    name="$(basename "$u" .service)"; name="${name#backpack-}"
    [[ $name =~ ^(webui|monitor|proxy)$ ]] && continue
    printf "    %-20s %s\n" "$name" "$(systemctl is-active "backpack-$name" 2>/dev/null || true)"; n=$((n+1))
  done
  (( n )) || echo -e "    ${D}none${N}"
}
password(){
  local a b
  read -rsp "  New password (min 6): " a; echo
  read -rsp "  Repeat: " b; echo
  [[ "$a" == "$b" ]] || { echo -e "  ${R}Passwords don't match.${N}"; return 1; }
  echo "$a" | python3 $APP/panel/server.py --set-password && systemctl restart kanki-panel
  echo -e "  ${G}Password changed.${N}"
}
ssl(){
  local domain="${1:-}"
  [[ -n "$domain" ]] || read -rp "  Domain (must point to this server): " domain
  [[ "$domain" =~ ^[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] || { echo -e "  ${R}Invalid domain.${N}"; return 1; }
  apt-get install -y -qq certbot >/dev/null
  if command -v ufw >/dev/null && ufw status | grep -q "Status: active"; then ufw allow 80/tcp >/dev/null; fi
  echo "  Requesting a Let's Encrypt certificate (port 80 must be free)..."
  certbot certonly --standalone -d "$domain" --non-interactive --agree-tos \
    --register-unsafely-without-email --deploy-hook "systemctl restart kanki-panel" \
    || { echo -e "  ${R}Failed. Check the domain's DNS and that port 80 is free.${N}"; return 1; }
  DOMAIN="$domain" python3 - <<'PY'
import json, os
p = "/etc/kanki/panel.json"; c = json.load(open(p)); d = os.environ["DOMAIN"]
c.update(domain=d, cert=f"/etc/letsencrypt/live/{d}/fullchain.pem", key=f"/etc/letsencrypt/live/{d}/privkey.pem")
json.dump(c, open(p, "w"), indent=2); os.chmod(p, 0o600)
PY
  systemctl restart kanki-panel
  echo -e "  ${G}SSL active (auto-renews).${N}"; info
}
update(){
  # shellcheck disable=SC1091
  source $ETC/install.env
  echo "  Updating from github.com/${KANKI_REPO} (private repo: export GH_TOKEN=... first)"
  local auth=() tmp; [[ -n "${GH_TOKEN:-}" ]] && auth=(-H "Authorization: Bearer $GH_TOKEN")
  tmp="$(mktemp)"
  curl -fsSL "${auth[@]}" "https://raw.githubusercontent.com/${KANKI_REPO}/${KANKI_BRANCH}/install.sh" -o "$tmp"
  KANKI_REPO="$KANKI_REPO" KANKI_BRANCH="$KANKI_BRANCH" KANKI_UPDATE_ENGINE="${1:-0}" bash "$tmp"; rm -f "$tmp"
}
uninstall(){
  local x y u
  read -rp "  Type REMOVE to uninstall the Kanki panel: " x; [[ $x == REMOVE ]] || return 0
  systemctl disable --now kanki-panel 2>/dev/null || true
  rm -f /etc/systemd/system/kanki-panel.service /usr/local/bin/kanki
  rm -rf $APP
  read -rp "  Also delete all tunnels and the BackPack engine? [y/N]: " y
  if [[ ${y,,} == y ]]; then
    for u in /etc/systemd/system/backpack-*.service; do
      [[ -e $u ]] || continue
      systemctl disable --now "$(basename "$u")" 2>/dev/null || true; rm -f "$u"
    done
    rm -rf /etc/backpack /usr/local/bin/backpack
  fi
  rm -rf $ETC; systemctl daemon-reload
  echo -e "  ${G}Removed.${N}"; exit 0
}
menu(){
  local c
  while :; do
    echo -e "\n  ${Y}Kanki Tunnel${N}"; info
    echo -e "\n  1) Change panel password\n  2) Get SSL for a domain\n  3) Restart panel\n  4) Panel logs\n  5) Update Kanki\n  6) Update BackPack engine\n  7) Uninstall\n  0) Exit"
    read -rp "  > " c
    case $c in
      1) password || true ;; 2) ssl || true ;; 3) systemctl restart kanki-panel; echo -e "  ${G}Restarted.${N}" ;;
      4) journalctl -u kanki-panel -n 50 --no-pager ;; 5) update 0 ;; 6) update 1 ;;
      7) uninstall ;; 0) exit 0 ;; *) ;;
    esac
  done
}
case "${1:-menu}" in
  menu) menu ;; info) info ;; password) password ;; ssl) ssl "${2:-}" ;;
  restart) systemctl restart kanki-panel ;; logs) journalctl -u kanki-panel -f ;;
  update) update 0 ;; uninstall) uninstall ;;
  *) echo "Usage: kanki [info|password|ssl <domain>|restart|logs|update|uninstall]" ;;
esac
